#!/usr/bin/env bash
# Git hook (applies to any tool or person): strips automatic AI assistant signatures
# from the commit message and checks the author.
# Enabled with: git config core.hooksPath .githooks   (scripts/setup-repo.sh does it)
set -euo pipefail

msg_file="$1"
pattern='^(co-authored-by:.*(claude|anthropic|copilot|cursor|codex|openai|devin|noreply@)|.*generated (with|by) \[?(claude|cursor|copilot|codex)|claude-session:|.*claude\.ai/code|🤖)'

if grep -Eiq "$pattern" "$msg_file"; then
  grep -Eiv "$pattern" "$msg_file" > "$msg_file.tmp" || true
  # strip extra trailing blank lines
  sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$msg_file.tmp" > "$msg_file"
  rm -f "$msg_file.tmp"
  echo "commit-msg: removed automatic AI signatures from the message." >&2
fi

expected="serbenda@gmail.com"
# git var also reflects --author and GIT_AUTHOR_EMAIL
actual="$(git var GIT_AUTHOR_IDENT | sed -E 's/.*<([^>]*)>.*/\1/')"
if [[ "$actual" != "$expected" ]]; then
  echo "commit-msg: the author email is '$actual' and must be '$expected'." >&2
  echo "  git config user.email \"$expected\"" >&2
  exit 1
fi
