{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.netrc)",
      "Edit(./.env)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main*)",
      "Bash(git push * main)",
      "Bash(git reset --hard *)",
      "Bash(git filter-branch *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Bash(gh secret *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(printenv*)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.claude/hooks/**)",
      "Edit(./.claude/agents/**)",
      "Edit(./.claude/commands/**)",
      "Edit(./.claude/skills/**)",
      "Edit(./.githooks/**)",
      "Bash(git push --all*)",
      "Bash(git push --mirror*)",
      "Bash(git commit --no-verify*)",
      "Bash(git -c *)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo rename *)",
      "Bash(gh auth *)",
      "Bash(rm -fr *)",
      "Bash(export -p*)",
      "Edit(./.github/**)",
      "Edit(./scripts/setup-repo.sh)",
      "Edit(./scripts/sync-from-template.sh)",
      "Edit(./scripts/check-records.sh)",
      "Edit(./scripts/test-guard.sh)",
      "Edit(./scripts/test-check-records.sh)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh api *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npx *)",
      "Bash(pip install *)",
      "WebFetch",
      "Bash(node *)",
      "Bash(rm -r *)",
      "Bash(git remote *)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git switch development)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(bash scripts/test-guard.sh)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "excludedCommands": [
      "git",
      "gh"
    ],
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.config/gh",
        "~/.config/gcloud",
        "~/.gnupg",
        "~/.kube",
        "~/.docker",
        "~/.netrc",
        "~/.npmrc",
        "~/Library/Keychains"
      ],
      "denyWrite": [
        "./.claude/settings.json",
        "./.claude/settings.local.json",
        "./.claude/hooks",
        "./.claude/agents",
        "./.claude/commands",
        "./.claude/skills",
        "./.githooks",
        "./.github",
        "./scripts/setup-repo.sh",
        "./scripts/sync-from-template.sh",
        "./scripts/check-records.sh",
        "./scripts/test-guard.sh",
        "./scripts/test-check-records.sh"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "ghcr.io",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "proxy.golang.org",
        "sum.golang.org",
        "crates.io",
        "*.crates.io",
        "pub.dev",
        "storage.googleapis.com"
      ],
      "allowLocalBinding": true
    }
  }
}
